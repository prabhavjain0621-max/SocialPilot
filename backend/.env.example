# ==============================================================================
# SocialPilot Backend Environment Configuration
# Copy this file or set these variables in the Render Dashboard -> Environment tab
# ==============================================================================

# --- Core API & Database ---
# Render Managed PostgreSQL provides this automatically if using Blueprints,
# or paste your External/Internal Connection String here:
DATABASE_URL=postgresql://user:password@host:5432/dbname

# JWT Authentication Secret Key (generate with: openssl rand -hex 32)
SECRET_KEY=your_super_secret_jwt_key_here_change_in_production

# URL of your deployed Vercel frontend (no trailing slash)
FRONTEND_URL=https://your-socialpilot.vercel.app

# Allowed CORS origins (comma-separated). Note: *.vercel.app is automatically allowed!
CORS_ORIGINS=http://localhost:5173,https://your-socialpilot.vercel.app

# Public URL of this Render backend (for serving uploaded media files)
PUBLIC_BASE_URL=https://socialpilot-api.onrender.com

# --- Background Worker & Scheduler (Optional, for recurring posts) ---
# If using Upstash Redis or Render Redis:
# REDIS_URL=redis://default:password@host:6379/0

# --- Google Gemini AI (Optional, for AI Post Generation) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# --- Social Platform OAuth Credentials (Configure as needed) ---

# LinkedIn OAuth 2.0
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_REDIRECT_URI=https://socialpilot-api.onrender.com/auth/linkedin/callback

# YouTube / Google OAuth 2.0
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REDIRECT_URI=https://socialpilot-api.onrender.com/auth/youtube/callback

# Instagram Graph API
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret
INSTAGRAM_REDIRECT_URI=https://socialpilot-api.onrender.com/auth/instagram/callback

# Facebook Graph API
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_REDIRECT_URI=https://socialpilot-api.onrender.com/auth/facebook/callback
FACEBOOK_CONFIG_ID=your_facebook_config_id

# X (Twitter) OAuth 2.0
X_CLIENT_ID=your_x_client_id
X_CLIENT_SECRET=your_x_client_secret
X_REDIRECT_URI=https://socialpilot-api.onrender.com/auth/x/callback
